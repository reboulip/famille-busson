    "package": "d3",
    "version": "7.9.0",
    "dir": "d3",
    "files": [
      { "src": "dist/d3.min.js", "dest": "d3.min.js" },
      { "src": "LICENSE", "dest": "LICENSE" }
    ]
  },
  "leaflet": {
    "package": "leaflet",
    "version": "1.9.4",
    "dir": "leaflet",
    "files": [
      { "src": "dist/leaflet.js", "dest": "leaflet.js" },
      { "src": "dist/leaflet.css", "dest": "leaflet.css" },
      { "src": "dist/images/layers-2x.png", "dest": "images/layers-2x.png" },
      { "src": "dist/images/layers.png", "dest": "images/layers.png" },
      { "src": "dist/images/marker-icon-2x.png", "dest": "images/marker-icon-2x.png" },
      { "src": "dist/images/marker-icon.png", "dest": "images/marker-icon.png" },
      { "src": "dist/images/marker-shadow.png", "dest": "images/marker-shadow.png" },
      { "src": "LICENSE", "dest": "LICENSE" }
    ]
  },
  "leaflet.markercluster": {
    "package": "leaflet.markercluster",
    "version": "1.5.3",
    "dir": "leaflet.markercluster",
    "files": [
      { "src": "dist/leaflet.markercluster.js", "dest": "leaflet.markercluster.js" },
      { "src": "dist/leaflet.markercluster.js.map", "dest": "leaflet.markercluster.js.map" },
      { "src": "dist/MarkerCluster.css", "dest": "MarkerCluster.css" },
      { "src": "LICENSE", "dest": "LICENSE" }
    ]
  },
  "family-chart": {
    "package": "family-chart",
    "version": "0.9.0",
    "dir": "family-chart",
    "files": [
      { "src": "dist/family-chart.min.js", "dest": "family-chart.min.js" },
      { "src": "dist/styles/family-chart.css", "dest": "family-chart.css" },
      { "src": "LICENSE.txt", "dest": "LICENSE" }
    ]
  },
  "html-to-image": {
    "package": "html-to-image",
    "version": "1.11.13",
    "dir": "html-to-image",
    "files": [
      { "src": "dist/html-to-image.js", "dest": "html-to-image.js" },
      { "src": "LICENSE", "dest": "LICENSE" }
    ]
  },
  "pdfjs": {
    "package": "pdfjs-dist",
    "version": "6.3.289",
    "dir": "pdfjs",
    "files": [
      { "src": "build/pdf.min.mjs", "dest": "pdf.min.mjs" },
      { "src": "build/pdf.worker.min.mjs", "dest": "pdf.worker.min.mjs" },
      { "src": "LICENSE", "dest": "LICENSE" }
    ]
  }
}
