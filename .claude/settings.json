{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(\"c:/Program Files/GitHub CLI/gh.exe\" *)",
      "Bash('c:/Program Files/GitHub CLI/gh.exe' *)",
      "Bash(gh *)",
      "Bash(uv *)",
      "Bash(where *)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push *:main)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git branch -D main)",
      "Bash(git branch -D develop)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\remind_makemigrations.ps1\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR\\.claude\\hooks\\end_task_ritual.ps1\""
          }
        ]
      }
    ]
  }
}
