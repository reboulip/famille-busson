# Reference for the vars settings.py reads via django-environ.
# Copy to .env for local overrides (optional, gitignored) or use as a checklist for
# /srv/bubu/.env on the VPS. Never commit a real .env.

# Core
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=bubu.reboulip.fr
CSRF_TRUSTED_ORIGINS=https://bubu.reboulip.fr

# Database — POSTGRES_* feed the postgres container itself (docker-compose.prod.yml),
# DATABASE_URL is what Django actually reads and must point at the same values.
POSTGRES_DB=bubu_db
POSTGRES_USER=bubu_user
POSTGRES_PASSWORD=
DATABASE_URL=postgres://bubu_user:<POSTGRES_PASSWORD>@db:5432/bubu_db

# Email — generic SMTP, defaults to the console backend (no-op) until a provider is
# chosen. Set EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend to enable.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@bubu.reboulip.fr

# Base URL for links in emails sent outside a request context (birthday reminders,
# blog post notifications).
SITE_BASE_URL=https://bubu.reboulip.fr

# Passwordless "magic link" login -- validity of the emailed link, in seconds.
MAGIC_LINK_TIMEOUT=900

# Shared cache (Valkey/Redis) -- db 0. Container-internal hostname/port aren't secrets,
# so docker-compose.prod.yml itself defaults this; only set it here to override.
# Defaults to an in-process cache (no sharing across gunicorn workers) if unset.
CACHE_URL=redis://cache:6379/0

# Automated backups (read by scripts/backup.sh, not by Django) -- see
# docs/deployment.md's "Sauvegardes" section.
BACKUP_DIR=/srv/bubu/backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_REMOTE=
BACKUP_AGE_RECIPIENT=
BACKUP_PING_URL=
BACKUP_MIN_DB_BYTES=1000
BACKUP_MIN_MEDIA_BYTES=0
BACKUP_MIN_DOCUMENTS_BYTES=0
BACKUP_MIN_DB_RATIO=0.5
BACKUP_MIN_MEDIA_RATIO=0.5
BACKUP_MIN_DOCUMENTS_RATIO=0
