{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:famille-busson:schema:bulletin:0.2",
  "title": "Bulletin package",
  "description": "Structured transcription of one scanned family bulletin (one PDF), produced by the PDF-to-package agent and imported into publications. Captures semantic structure only: the website owns the layout. Cross-references (ids, image files, row widths) are checked by tools/validate.py, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "series", "issue", "date", "language", "source", "images", "articles", "processing"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "0.2" },
    "id": {
      "$ref": "#/$defs/slug",
      "description": "Corpus-wide unique document id, e.g. 'bc-017' (series code + zero-padded issue number). Prefixes every image id."
    },
    "title": {
      "type": "string", "minLength": 1, "maxLength": 200,
      "description": "Display title for listings, e.g. \"Busson's Connection n°17\"."
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "title"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9]{1,10}$", "description": "Short series code as used in file names, e.g. 'BC'." },
        "title": { "type": "string", "minLength": 1, "description": "Series title as printed, e.g. \"Busson's Connection\"." }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number"],
      "properties": {
        "number": { "type": ["integer", "null"], "minimum": 0, "description": "Issue number; null for a special issue with no number." },
        "label": { "type": "string", "description": "Printed label when it is not a plain number, e.g. '17 bis' or 'Hors-série'." }
      }
    },
    "date": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "text"],
      "properties": {
        "value": { "$ref": "#/$defs/partial_date" },
        "text": { "type": "string", "minLength": 1, "description": "Date as printed, e.g. 'avril 1995'." }
      }
    },
    "language": { "type": "string", "pattern": "^[a-z]{2}$", "default": "fr" },
    "credits": {
      "type": "array",
      "description": "Editorial team as printed on the masthead, grouped by printed role.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "names"],
        "properties": {
          "role": { "type": "string", "minLength": 1, "description": "As printed, e.g. 'Rédacteurs adjoints'." },
          "names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "summary": {
      "type": "string", "maxLength": 600,
      "description": "Short, neutral summary for listing cards and search. Generated by the agent (not verbatim); must not surface sensitive details."
    },
    "masthead_image": { "$ref": "#/$defs/image_ref", "description": "Crop of the printed masthead/logo, shown in the page header." },
    "cover_image": { "$ref": "#/$defs/image_ref", "description": "Thumbnail for listings; defaults to the first page image." },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "sha256", "page_count", "pages"],
      "properties": {
        "file_name": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256", "description": "Hash of the source PDF: lets the importer detect a re-import of the same file." },
        "page_count": { "type": "integer", "minimum": 1 },
        "producer": { "type": "string", "description": "Scanner/software from the PDF metadata." },
        "scanned_on": { "$ref": "#/$defs/partial_date" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "description": "One entry per PDF page, in order, with its full-page preview image.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "image"],
            "properties": {
              "number": { "type": "integer", "minimum": 1 },
              "image": { "$ref": "#/$defs/image_ref" }
            }
          }
        }
      }
    },
    "images": {
      "type": "array",
      "description": "Every picture in the package. Blocks reference them by id.",
      "items": { "$ref": "#/$defs/image" }
    },
    "articles": {
      "type": "array",
      "minItems": 1,
      "description": "Content in reading order. Consecutive articles sharing a rubric are grouped under one rubric heading.",
      "items": { "$ref": "#/$defs/article" }
    },
    "marginalia": {
      "type": "array",
      "description": "Annotations added to the paper after publication (pencil notes, archive stamps...). Kept for provenance, rendered outside the article flow.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "image", "description"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "image": { "$ref": "#/$defs/image_ref" },
          "description": { "type": "string", "minLength": 1 },
          "transcript": { "type": ["string", "null"] }
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "date", "conventions"],
      "properties": {
        "agent": { "type": "string", "description": "Tool/agent that produced the package." },
        "model": { "type": "string" },
        "date": { "$ref": "#/$defs/partial_date" },
        "conventions": { "const": "faithful-v1", "description": "Transcription conventions applied (see spec)." },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["draft", "reviewed"] },
            "reviewer": { "type": "string" },
            "date": { "$ref": "#/$defs/partial_date" }
          }
        },
        "notes": {
          "type": "array",
          "description": "Transcription notes for reviewers: uncertain readings, inferred data, layout decisions.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "message"],
            "properties": {
              "level": { "enum": ["info", "warning"] },
              "page": { "type": "integer", "minimum": 1 },
              "article": { "$ref": "#/$defs/slug" },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "partial_date": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$",
      "description": "ISO 8601 date with optional month/day precision: 'YYYY', 'YYYY-MM' or 'YYYY-MM-DD'."
    },
    "local_datetime": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])(T([01]\\d|2[0-3]):[0-5]\\d)?$",
      "description": "Local date or date-time without time zone: 'YYYY-MM-DD' or 'YYYY-MM-DDTHH:MM'."
    },
    "image_ref": { "$ref": "#/$defs/slug", "description": "Id of an entry in images[]." },
    "script": { "enum": ["typed", "handwritten", "mixed"] },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "kind", "media_type", "width", "height", "sha256", "source", "alt"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "file": { "type": "string", "pattern": "^images/[a-z0-9]+(?:-[a-z0-9]+)*\\.(jpg|png|webp)$", "description": "Path inside the package: images/<id>.<ext>." },
        "kind": {
          "enum": ["page", "masthead", "photo", "illustration", "handwriting", "signature", "document"],
          "description": "page = full-page preview; handwriting/signature = crops of ink on paper (the renderer blends them into the page background)."
        },
        "media_type": { "enum": ["image/jpeg", "image/png", "image/webp"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page"],
          "properties": {
            "page": { "type": "integer", "minimum": 1 },
            "bbox": {
              "type": "array",
              "minItems": 4, "maxItems": 4,
              "items": { "type": "number", "minimum": 0, "maximum": 1 },
              "description": "[x0, y0, x1, y1] as fractions of the displayed (rotation-applied) page, origin top-left. Omitted for kind=page."
            },
            "dpi": { "type": "integer", "minimum": 50, "maximum": 600 }
          }
        },
        "alt": { "type": "string", "minLength": 1, "description": "Alternative text in the document language. Captions belong to where the picture is placed (figure, gallery item), not here." },
        "transcript": { "type": ["string", "null"], "description": "Best-effort reading of a handwriting/signature crop; null when illegible." }
      }
    },
    "mark": { "enum": ["bold", "italic", "underline", "strike", "superscript"] },
    "inline": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "marks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/mark" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "description": "A reading the agent is not sure of.",
          "properties": {
            "kind": { "const": "uncertain" },
            "text": { "type": "string", "minLength": 1 },
            "alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "marks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/mark" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "image"],
          "description": "A word or short passage that could not be read: shown as an inline crop of the scan.",
          "properties": {
            "kind": { "const": "illegible" },
            "image": { "$ref": "#/$defs/image_ref" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "description": "A meaningful line break (addresses, verse, lists written as lines).",
          "properties": { "kind": { "const": "break" } }
        }
      ]
    },
    "inline_text": {
      "description": "Plain string, or a sequence of runs when formatting/uncertainty is needed.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inline" } }
      ]
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "script", "pages", "blocks"],
      "anyOf": [ { "required": ["title"] }, { "required": ["rubric"] } ],
      "properties": {
        "id": { "$ref": "#/$defs/slug", "description": "Unique within the document; used as the page anchor." },
        "rubric": { "type": "string", "minLength": 1, "description": "Recurring section name as printed, e.g. 'Le courrier de nos lecteurs'." },
        "kicker": { "type": "string", "minLength": 1, "description": "Small label printed above the title, e.g. 'Invitation 2 personnes'." },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "byline": { "$ref": "#/$defs/inline_text", "description": "Authorship as printed, e.g. 'par Jean'." },
        "script": { "$ref": "#/$defs/script", "description": "Dominant script of the article." },
        "pages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block_types": {
      "enum": ["paragraph", "heading", "list", "quote", "separator", "figure", "gallery", "table", "event", "signature", "address", "news_item", "aside"]
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "$ref": "#/$defs/block_types" } },
      "allOf": [
        { "$ref": "#/$defs/simple_block_dispatch" },
        { "if": { "properties": { "type": { "const": "news_item" } } }, "then": { "$ref": "#/$defs/news_item" } },
        { "if": { "properties": { "type": { "const": "aside" } } }, "then": { "$ref": "#/$defs/aside" } }
      ]
    },
    "simple_block": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["paragraph", "heading", "list", "quote", "separator", "figure", "gallery", "table", "event", "signature", "address"] } },
      "allOf": [ { "$ref": "#/$defs/simple_block_dispatch" } ]
    },
    "simple_block_dispatch": {
      "allOf": [
        { "if": { "properties": { "type": { "const": "paragraph" } } }, "then": { "$ref": "#/$defs/paragraph" } },
        { "if": { "properties": { "type": { "const": "heading" } } }, "then": { "$ref": "#/$defs/heading" } },
        { "if": { "properties": { "type": { "const": "list" } } }, "then": { "$ref": "#/$defs/list" } },
        { "if": { "properties": { "type": { "const": "quote" } } }, "then": { "$ref": "#/$defs/quote" } },
        { "if": { "properties": { "type": { "const": "separator" } } }, "then": { "$ref": "#/$defs/separator" } },
        { "if": { "properties": { "type": { "const": "figure" } } }, "then": { "$ref": "#/$defs/figure" } },
        { "if": { "properties": { "type": { "const": "gallery" } } }, "then": { "$ref": "#/$defs/gallery" } },
        { "if": { "properties": { "type": { "const": "table" } } }, "then": { "$ref": "#/$defs/table" } },
        { "if": { "properties": { "type": { "const": "event" } } }, "then": { "$ref": "#/$defs/event" } },
        { "if": { "properties": { "type": { "const": "signature" } } }, "then": { "$ref": "#/$defs/signature" } },
        { "if": { "properties": { "type": { "const": "address" } } }, "then": { "$ref": "#/$defs/address" } }
      ]
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "paragraph" },
        "text": { "$ref": "#/$defs/inline_text" },
        "script": { "$ref": "#/$defs/script", "description": "Only when it differs from the article's script." }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "level", "text"],
      "properties": {
        "type": { "const": "heading" },
        "level": { "enum": [1, 2], "description": "Relative to the article title: 1 = section, 2 = sub-section." },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "style", "items"],
      "properties": {
        "type": { "const": "list" },
        "style": { "enum": ["bullet", "numbered"] },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inline_text" } },
        "script": { "$ref": "#/$defs/script" }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "paragraphs"],
      "properties": {
        "type": { "const": "quote" },
        "paragraphs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inline_text" } },
        "attribution": { "type": "string", "minLength": 1 },
        "script": { "$ref": "#/$defs/script" }
      }
    },
    "separator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "separator" } }
    },
    "caption_editorial": {
      "type": "boolean",
      "default": false,
      "description": "true when the caption was written during transcription (the original prints none): the renderer marks it as added."
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "image"],
      "description": "One picture in the flow. Pictures (photo, illustration, document) dock right with the text wrapping around them; consecutive pictures with no text between them are shown together as a carousel.",
      "properties": {
        "type": { "const": "figure" },
        "image": { "$ref": "#/$defs/image_ref" },
        "caption": { "$ref": "#/$defs/inline_text", "description": "The printed caption, or one written during transcription (then set caption_editorial)." },
        "caption_editorial": { "$ref": "#/$defs/caption_editorial" }
      }
    },
    "gallery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "description": "Several pictures presented together with little or no text (a photo page, a collage): rendered as a carousel. Short texts that belong to the pictures go into their captions.",
      "properties": {
        "type": { "const": "gallery" },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["image"],
            "properties": {
              "image": { "$ref": "#/$defs/image_ref" },
              "caption": { "$ref": "#/$defs/inline_text" },
              "caption_editorial": { "$ref": "#/$defs/caption_editorial" }
            }
          }
        },
        "caption": { "$ref": "#/$defs/inline_text", "description": "Caption of the whole group (e.g. a photo page's title)." },
        "caption_editorial": { "$ref": "#/$defs/caption_editorial" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "columns", "row_groups"],
      "properties": {
        "type": { "const": "table" },
        "caption": { "type": "string", "minLength": 1 },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "key": { "type": "boolean", "default": false, "description": "Short identifier column (codes, numbers): rendered narrow, with tabular figures, and used as the row label on mobile." }
            }
          }
        },
        "row_groups": {
          "type": "array",
          "minItems": 1,
          "description": "Bands of rows separated by a rule in the original (one group for a plain table).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rows"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "rows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "oneOf": [ { "$ref": "#/$defs/inline_text" }, { "type": "null" } ] },
                  "description": "One cell per column; null = empty cell."
                }
              }
            }
          }
        },
        "footnote": { "type": "string", "minLength": 1 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "dates"],
      "description": "Structured facts of an announcement or invitation (the prose stays in paragraphs).",
      "properties": {
        "type": { "const": "event" },
        "title": { "type": "string", "minLength": 1 },
        "organizer": { "type": "string", "minLength": 1 },
        "dates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "description": "As printed (lightly normalized when one printed line holds several dates)." },
              "start": { "$ref": "#/$defs/local_datetime" },
              "end": { "$ref": "#/$defs/local_datetime" }
            }
          }
        },
        "place": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [ { "required": ["name"] }, { "required": ["locality"] } ],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "locality": { "type": "string", "minLength": 1 }
          }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "anyOf": [ { "required": ["name"] }, { "required": ["image"] }, { "required": ["closing"] } ],
      "properties": {
        "type": { "const": "signature" },
        "closing": { "$ref": "#/$defs/inline_text", "description": "e.g. 'Grosses bises'." },
        "role": { "type": "string", "minLength": 1, "description": "e.g. \"L'animateur\"." },
        "name": { "$ref": "#/$defs/inline_text" },
        "image": { "$ref": "#/$defs/image_ref", "description": "Crop of the handwritten signature." },
        "script": { "$ref": "#/$defs/script" }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "lines"],
      "description": "Postal/contact details. Personal data: the renderer applies the site's visibility policy.",
      "properties": {
        "type": { "const": "address" },
        "lines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "news_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "subject", "blocks"],
      "description": "One entry of a 'Name: news' list (family news, carnet...).",
      "properties": {
        "type": { "const": "news_item" },
        "subject": { "$ref": "#/$defs/inline_text", "description": "Who the entry is about, as written (usually a first name)." },
        "headline": { "$ref": "#/$defs/inline_text" },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/simple_block" } }
      }
    },
    "aside": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "blocks"],
      "description": "A boxed insert (encadré) inside an article.",
      "properties": {
        "type": { "const": "aside" },
        "title": { "type": "string", "minLength": 1 },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/simple_block" } }
      }
    }
  }
}
